{
  "name": "kpimaster-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:apk": "npx eas-cli build --platform android --profile apk",
    "build:android:apk:local": "expo prebuild --platform android && cd android && JAVA_HOME=${JAVA_HOME:-/usr/lib/jvm/java-21-jdk} ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$HOME/Android/Sdk} NODE_ENV=production ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.4",
    "@tanstack/react-query": "^5.83.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-font": "~13.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.6",
    "react": "18.3.1",
    "react-native": "^0.76.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.23",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
