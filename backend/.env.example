# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=SprintPulse
APP_VERSION=1.0.0
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-32-char-minimum
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
AUTH_ENABLED=true
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sprintpulse:sprintpulse@localhost:5432/sprintpulse
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_BACKEND=redis://localhost:6379/1
REDIS_PUBSUB_CHANNEL_PREFIX=sprintpulse

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Notification Channels ────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=SprintPulse <noreply@example.com>

# ─── Blocker Detection Thresholds ─────────────────────────────────────────────
STALL_THRESHOLD_L1_HOURS=24
STALL_THRESHOLD_L2_HOURS=48
STALL_THRESHOLD_L3_HOURS=72

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
METRICS_ENABLED=true

JIRA_CLIENT_ID=your_atlassian_app_client_id
JIRA_CLIENT_SECRET=your_atlassian_app_secret
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_secret
GEMINI_API_KEY=
AUTH_ENABLED=true
